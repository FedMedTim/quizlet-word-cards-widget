<?xml version="1.0" encoding="utf-8"?>
<!-- Корпус карточки: плотная 2dp рамка и нижняя пара угловых скобок.
     Скобки запечены в фон, а не выложены отдельными слоями поверх содержимого:
     полноразмерные слои в виджете перехватывают тапы. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="2dp" android:color="@color/ink" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/bracket_bl"
        android:gravity="bottom|left"
        android:width="10dp"
        android:height="10dp"
        android:left="4dp"
        android:bottom="4dp" />
    <item
        android:drawable="@drawable/bracket_br"
        android:gravity="bottom|right"
        android:width="10dp"
        android:height="10dp"
        android:right="4dp"
        android:bottom="4dp" />
</layer-list>
